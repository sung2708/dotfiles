# Ghostty — kept in step with wezterm/wezterm.lua.
# Check after editing: ghostty +validate-config

# ── Shell: open or attach tmux session "sungp" (falls back to zsh) ─────────
command = /bin/zsh -lc 'export PATH="$PATH:/opt/local/bin:/opt/homebrew/bin:/usr/local/bin:/home/linuxbrew/.linuxbrew/bin"; tmux new-session -A -s sungp || exec /bin/zsh -l'

# ── Font (bundled JetBrains Mono + Nerd Font symbols) ──────────────────────
# Regular-weight upright text keeps Bold and Italic meaningful in Neovim.
font-family = JetBrains Mono
font-style = Medium
font-size = 13
adjust-cell-height = 5%

# ── Colours: Catppuccin Mocha, same as WezTerm / Neovim ────────────────────
theme = Catppuccin Mocha
selection-background = f9e2af
selection-foreground = 1e1e2e

# ── Window ─────────────────────────────────────────────────────────────────
background-opacity = 0.90
background-blur = 20
macos-titlebar-style = hidden      # tmux provides windows and panes
window-padding-x = 6
window-padding-y = 4,0
window-padding-balance = true
window-colorspace = display-p3
maximize = true
confirm-close-surface = false      # the tmux session survives

# ── Cursor / mouse ─────────────────────────────────────────────────────────
cursor-style = bar
cursor-style-blink = false
shell-integration-features = no-cursor,sudo,no-title
mouse-hide-while-typing = true
copy-on-select = clipboard

# ── Keyboard ───────────────────────────────────────────────────────────────
# Left Option sends Alt (Neovim/tmux Alt+h/j/k/l); right Option types accents.
macos-option-as-alt = left

keybind = cmd+s>r=reload_config
